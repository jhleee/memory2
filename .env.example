# Runtime does not automatically load this file. Inject variables through your shell/host.
RPG_DB=./rpg.db
RPG_LOCAL_USER=developer
HOST=127.0.0.1
PORT=3000
# Development HTTP only; never use a sample token for public hosting.
# RPG_DEV_TOKEN=choose-a-local-test-token
# Public deployment without an IdP. Generate a long random value and keep it secret.
# RPG_BEARER_TOKEN=inject-through-secret-manager
# RPG_PUBLIC_URL=https://memory.example
# Production IdP settings; leave RPG_DEV_TOKEN unset.
# OIDC_ISSUER=https://idp.example/
# OIDC_AUDIENCE=https://rpg.example/mcp
# OIDC_JWKS_URL=https://idp.example/.well-known/jwks.json
# OIDC_SCOPE=rpg
# Optional Decision provider. No embeddings or built-in GM calls in the server.
# OPENROUTER_API_KEY=inject-through-secret-manager
OPENROUTER_GM_MODEL=recursive/flint-v1.0:free
OPENROUTER_DECISION_MODEL=baseten/mammoth-1:free
# Node.js 24 proxy support, when required by the execution environment.
# NODE_USE_ENV_PROXY=1
